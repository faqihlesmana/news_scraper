# Gemini API Key (dapatkan dari Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend AI: "hybrid" (Gemini + Qwen), "ollama", atau "gemini"
AI_BACKEND=hybrid

# Ollama Settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Supabase / PostgreSQL Database Connection (Kosongkan jika ingin pakai SQLite lokal data/news_scraper.db)
# Dapatkan dari Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Flask Settings
FLASK_SECRET_KEY=your-secret-key
PORT=5555
FLASK_DEBUG=false
